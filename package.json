{
  "name": "snepmi-miniapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SNEPMI AGENCY: Telegram Mini App (landing + blogger catalogue + lead inbox) with built-in admin panel and bot",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "setup": "npm run migrate && npm run seed",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "grammy": "^1.33.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "zod": "^3.24.1"
  }
}
